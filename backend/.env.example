APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-development-secret
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000
LOCAL_AUTH_ENABLED=true

# Generic OIDC/JWKS bearer validation (required outside APP_ENV=development).
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_USER_ID_CLAIM=sub
AUTH_TENANT_ID_CLAIM=tenant_id
AUTH_JWKS_TIMEOUT_SECONDS=5

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=tattva_dev

FILE_STORAGE_ROOT=./data/uploads
MAX_UPLOAD_MB=25
MAX_DOCUMENT_CHARS=20000000
CHUNK_MAX_CHARS=3000
CHUNK_OVERLAP_CHARS=300

REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=tattva_case_chunks
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_ROOT=./data/embedding_cache

# OpenAI-compatible chat-completions endpoint, e.g. a provider's /v1 base URL
CORE_LLM_BASE_URL=
CORE_LLM_API_KEY=
CORE_LLM_MODEL=
CORE_LLM_TIMEOUT_SECONDS=45
CORE_LLM_MAX_OUTPUT_TOKENS=2048

GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
VOICE_MAX_SESSION_SECONDS=600
VOICE_MAX_CONCURRENT_SESSIONS=2

MAX_TASKS_PER_RUN=20
MAX_REPLAN_ROUNDS=2
MAX_RETRIES_PER_TASK=1
MAX_CONCURRENT_TASKS=3
MAX_TASK_TIMEOUT_SECONDS=120
MAX_CONCURRENT_RUNS=2
RUN_ANALYSIS_WORKERS=true
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=300
